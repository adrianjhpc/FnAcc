#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  fnacc-flang [options] file...
  fnacc-flang -c [options] source.f90 [-o source.o]
  fnacc-flang [options] source.f90 objects... libraries... -o program

Compiler-driver behavior:
  * Ordinary Fortran sources are compiled by flang with user flags preserved.
  * Sources containing !$fnacc (also c$fnacc and *$fnacc) use the FNACC pipeline.
  * -c produces a normal relocatable object. An FNACC object includes its host
    code and embedded PTX/JSON, so it can be linked in a later invocation.
  * Without -c, sources are compiled to temporary objects and then linked with
    user objects, archives, libraries, and linker flags in command-line order.
  * -E, -S, and -fsyntax-only are passed directly to flang. They do not run the
    accelerator code-generation pipeline.

Traditional options:
  -c                       Compile, but do not link
  -o FILE                  Write object or executable to FILE
  -I DIR, -IDIR            Include/module search directory
  -J DIR, -JDIR            Fortran module output/search directory
  -L DIR, -LDIR            Library search directory
  -l LIB, -lLIB            Link library
  -D..., -U..., -O..., -g, -f..., -m..., -Wl,...
                           Passed through to the appropriate compiler/link step
  --                       Treat all remaining arguments as input files

FNACC options:
  --fnacc-force            Run FNACC lowering for every Fortran source
  --fnacc-disable          Never run FNACC lowering; delegate sources to flang
  --fnacc-runtime          Force FNACC runtime libraries into the link
  --fnacc-no-runtime       Do not auto-add FNACC runtime libraries
  --fnacc-sm NUM           CUDA SM version, e.g. 80, sm_80, or cc80
  --fnacc-num-warps N      Triton warps; default FNACC_NUM_WARPS or 1
  --fnacc-threads-per-warp N
                           Threads per warp; CUDA currently requires 32
  --fnacc-num-stages N     Triton pipeline stages; default FNACC_NUM_STAGES or 3
  --fnacc-f64-matmul-strategy NAME
                           reduce, fma, or dot
  --fnacc-cuda-lib-dir DIR CUDA driver library directory
  --fnacc-workdir DIR      Parent for a unique intermediate directory
  --fnacc-keep             Keep intermediate files
  --fnacc-verbose          Print commands before running them
  --fnacc-dry-run          Print commands without executing them
  --fnacc-stop-after STAGE Stop one FNACC source after a named internal stage
  -h, --help               Show this help

Compatibility aliases:
  --sm, --num-warps, --threads-per-warp, --num-stages,
  --f64-matmul-strategy, --cuda-lib-dir, --workdir, --keep,
  --verbose, --dry-run, and --stop-after are accepted as aliases.

Limitations:
  The current runtime accepts one embedded FNACC kernel bundle per executable.
  The driver rejects links containing more than one FNACC-bearing object rather
  than producing a binary that aborts during startup. Ordinary objects and
  sources are unrestricted. Auto-detection scans named objects and archives;
  use --fnacc-runtime when FNACC code is supplied only through -lNAME.

Environment:
  LLVM_BUILD               llvm-project build directory
  TRITON_OPT               path to triton-opt
  MLIR_TRANSLATE           path to mlir-translate
  LLC                      path to llc
  CUDA_LIB_DIR             Optional CUDA driver library directory

Optional environment:
  FNACC_NUM_WARPS          number of warps to use, defaults to 1
  FNACC_THREADS_PER_WARP   threads per warp, defaults to 32
  FNACC_NUM_STAGES         number of Triton pipeline stages, defaults to 3
  FNACC_SM                 default CUDA SM, default 80
  FNACC_WORKDIR            default work directory. If unset, uses a temp dir.
  FLANG                    override flang-new
  FLANG_INTRINSIC_MODULES_PATH
                           override Flang's precompiled intrinsic module dir
  FIROPT                   override fir-opt
  TCO                      override tco
  CLANG                    override clang

Advanced environment:
  FNACC_TTGIR_TO_LLVM_PASSES
                           Override TTGIR -> LLVM MLIR pass pipeline.
                           Parsed with shell-like quoting.
  FNACC_TTIR_TO_TTGIR_PASSES
                           Override TTIR -> TTGIR pass pipeline.
                           Parsed with shell-like quoting.
  FNACC_PATCH_TTG_WARP_ID  Patch residual ttg.warp_id with NVPTX inline asm.
                           Default: 0 (use only with a validated Triton revision)
  FNACC_ALLOW_EMPTY_KERNELS
                           Allow no recognized kernels in generated JSON.
                           Default: 0
EOF
}

die() {
  echo "fnacc-flang: error: $*" >&2
  exit 1
}

warn() {
  echo "fnacc-flang: warning: $*" >&2
}

log() {
  echo "[fnacc-flang] $*" >&2
}

quote_cmd() {
  printf '+'
  printf ' %q' "$@"
  printf '\n'
}

run() {
  if [[ "$VERBOSE" == "1" || "$DRY_RUN" == "1" ]]; then
    quote_cmd "$@"
  fi
  if [[ "$DRY_RUN" != "1" ]]; then
    "$@"
  fi
}

require_file() {
  [[ -f "$1" ]] || die "file not found: $1"
}

require_exe() {
  [[ -x "$1" ]] || die "executable not found or not executable: $1"
}

abspath() {
  python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$1"
}

hash_path() {
  python3 -c 'import hashlib,os,sys; print(hashlib.sha1(os.path.abspath(sys.argv[1]).encode()).hexdigest()[:8])' "$1"
}

make_temp_file() {
  mktemp "$WORKDIR/.fnacc-check.XXXXXX"
}

object_for_src() {
  local src="$1"
  local stem hash
  stem="$(basename "$src")"
  stem="${stem%.*}"
  hash="$(hash_path "$src")"
  echo "$OBJ_DIR/${stem}_${hash}.o"
}

maybe_stop() {
  local stage="$1"
  if [[ "$STOP_AFTER" == "$stage" ]]; then
    log "stopping after stage: $stage"
    log "workdir kept: $WORKDIR"
    exit 0
  fi
}

generate_embedded_bundle_c() {
  local manifest="$1"
  local json_file="$2"
  local out_c="$3"

  python3 - "$manifest" "$json_file" "$out_c" <<'PY'
import json
import re
import sys
from pathlib import Path

manifest_path = Path(sys.argv[1])
json_path = Path(sys.argv[2])
out_path = Path(sys.argv[3])

rows = json.loads(manifest_path.read_text(encoding="utf-8"))
json_bytes = json_path.read_bytes()

def c_ident(s):
    return re.sub(r'[^A-Za-z0-9_]', '_', s)

def emit_array(name, data):
    lines = []
    lines.append(f"static const unsigned char {name}[] __attribute__((aligned(16))) = {{")
    for i in range(0, len(data), 12):
        chunk = data[i:i + 12]
        lines.append("  " + ", ".join(f"0x{b:02x}" for b in chunk) + ",")
    lines.append("};")
    return "\n".join(lines)

chunks = []
ptx_array_names = []

for row in rows:
    name = c_ident(row["name"])
    arr = f"__fnacc_embedded_ptx_{row['index']}_{name}"
    ptx_array_names.append(arr)
    ptx_bytes = Path(row["ptx"]).read_bytes()
    chunks.append(emit_array(arr, ptx_bytes))

chunks.append(emit_array("__fnacc_embedded_json", json_bytes))

ptrs = ",\n  ".join(f"(const char *){name}" for name in ptx_array_names)
sizes = ",\n  ".join(f"sizeof({name})" for name in ptx_array_names)

content = f"""\
#include <stddef.h>

extern void __fnacc_register_embedded_kernel_bundle(
    const char * const *ptxData,
    const size_t *ptxSizes,
    size_t ptxCount,
    const char *jsonData,
    size_t jsonSize);

// The runtime currently owns one process-wide bundle.  Keeping a strong marker
// in every fat object makes an unsupported multi-bundle link fail immediately,
// including when a linker other than this driver is used.
__attribute__((used, visibility("default")))
const unsigned char __fnacc_single_embedded_bundle = 1;

{chr(10).join(chunks)}

static const char *__fnacc_embedded_ptx_ptrs[] = {{
  {ptrs}
}};

static const size_t __fnacc_embedded_ptx_sizes[] = {{
  {sizes}
}};

__attribute__((constructor))
static void __fnacc_register_embedded_payload(void) {{
  __fnacc_register_embedded_kernel_bundle(
      __fnacc_embedded_ptx_ptrs,
      __fnacc_embedded_ptx_sizes,
      sizeof(__fnacc_embedded_ptx_ptrs) / sizeof(__fnacc_embedded_ptx_ptrs[0]),
      (const char *)__fnacc_embedded_json,
      sizeof(__fnacc_embedded_json));
}}
"""

out_path.write_text(content, encoding="utf-8")
PY
}

validate_ptx_kernel_abi() {
  local manifest="$1"
  local json_file="$2"

  python3 - "$manifest" "$json_file" <<'PY'
import json
import re
import sys
from pathlib import Path

manifest = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
metadata = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))
kernels = metadata.get("kernels", [])

if len(manifest) != len(kernels):
    raise SystemExit(
        f"fnacc-flang: error: manifest has {len(manifest)} kernels but JSON has {len(kernels)}"
    )

by_name = {str(k.get("name")): k for k in kernels}
for row in manifest:
    name = str(row["name"])
    kernel = by_name.get(name)
    if kernel is None:
        raise SystemExit(f"fnacc-flang: error: no JSON metadata for PTX kernel {name}")

    text = Path(row["ptx"]).read_text(encoding="utf-8")
    # Match the entry declaration itself, not the start of its body.  LLVM's
    # NVPTX backend may place directives such as `.maxntid` between the closing
    # parameter parenthesis and `{`, so requiring `) {` rejects valid PTX.
    # Anchoring at the beginning of a line prevents matches in comments while
    # still accepting the PTX linkage qualifiers used for kernel entries.
    match = re.search(
        r"^[ \t]*(?:\.(?:visible|extern|weak)[ \t]+)*\.entry[ \t]+"
        + re.escape(name)
        + r"[ \t]*\((.*?)\)",
        text,
        flags=re.MULTILINE | re.DOTALL,
    )
    if match is None:
        raise SystemExit(f"fnacc-flang: error: PTX entry {name} was not found in {row['ptx']}")

    actual = len(re.findall(r"\.param\b", match.group(1)))
    explicit = len(kernel.get("params", []))
    expected_hidden = int(kernel.get("triton_hidden_ptr_args", 2))
    actual_hidden = actual - explicit
    if actual_hidden != expected_hidden:
        raise SystemExit(
            "fnacc-flang: error: Triton/runtime ABI mismatch for "
            f"{name}: PTX has {actual} parameters ({actual_hidden} hidden), "
            f"but metadata expects {explicit} explicit + {expected_hidden} hidden. "
            "Use matching LLVM/Triton sources; do not run this binary."
        )
PY
}

write_toolchain_manifest() {
  local output="$1"
  {
    printf 'generated_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    local tool path
    for tool in FLANG FIROPT TCO CLANG TRITON_OPT MLIR_TRANSLATE LLC; do
      path="${!tool}"
      printf '%s=%q\n' "$tool" "$path"
      printf '%s_VERSION=' "$tool"
      "$path" --version 2>&1 | head -1 || true
    done
    printf 'SM=%s\nNUM_WARPS=%s\nTHREADS_PER_WARP=%s\nNUM_STAGES=%s\n' \
      "$SM" "$NUM_WARPS" "$THREADS_PER_WARP" "$NUM_STAGES"
  } > "$output"
}

validate_json() {
  local json_file="$1"
  python3 -m json.tool "$json_file" >/dev/null || die "invalid JSON: $json_file"
}

validate_kernel_json_nonempty() {
  local json_file="$1"

  python3 - "$json_file" "${FNACC_ALLOW_EMPTY_KERNELS:-0}" <<'PY'
import json
import sys

path = sys.argv[1]
allow_empty = sys.argv[2] == "1"
with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)

kernels = data.get("kernels", [])
if data.get("fnacc_schema_version") != 1:
    print(f"fnacc-flang: error: unsupported FNACC JSON schema in {path}", file=sys.stderr)
    raise SystemExit(1)
if not kernels and not allow_empty:
    print(f"fnacc-flang: error: no kernels were emitted into {path}", file=sys.stderr)
    print("This usually means no FNACC launch was recognized.", file=sys.stderr)
    print("Set FNACC_ALLOW_EMPTY_KERNELS=1 to allow this.", file=sys.stderr)
    raise SystemExit(1)

for kernel in kernels:
    if not isinstance(kernel.get("params"), list):
        print("fnacc-flang: error: kernel JSON has no parameter list", file=sys.stderr)
        raise SystemExit(1)
    if int(kernel.get("triton_hidden_ptr_args", -1)) != 2:
        print(
            "fnacc-flang: error: this runtime supports exactly two hidden Triton parameters",
            file=sys.stderr,
        )
        raise SystemExit(1)
PY
}

validate_no_triton_gpu_ops() {
  local file="$1"

  local ttg_left
  local tt_left

  ttg_left="$(make_temp_file)"
  tt_left="$(make_temp_file)"

  grep -nE '^[[:space:]]*((%[A-Za-z0-9_.$#-]+[[:space:]]*=[[:space:]]*)?)("?ttg\.)' \
    "$file" > "$ttg_left" || true

  if [[ -s "$ttg_left" ]]; then
    echo "fnacc-flang: error: residual TritonGPU dialect ops remain after LLVM lowering:" >&2
    head -20 "$ttg_left" >&2
    echo >&2
    echo "This usually means the Triton pass pipeline did not fully lower TTGIR." >&2
    echo "Check that triton-opt provides --convert-nv-gpu-to-llvm, or set FNACC_TTGIR_TO_LLVM_PASSES." >&2
    echo "As a temporary workaround, compile with --fnacc-num-warps 1." >&2
    rm -f "$ttg_left" "$tt_left"
    exit 1
  fi

  grep -nE '^[[:space:]]*((%[A-Za-z0-9_.$#-]+[[:space:]]*=[[:space:]]*)?)("?tt\.)' \
    "$file" > "$tt_left" || true

  if [[ -s "$tt_left" ]]; then
    echo "fnacc-flang: error: residual Triton dialect ops remain after LLVM lowering:" >&2
    head -20 "$tt_left" >&2
    rm -f "$ttg_left" "$tt_left"
    exit 1
  fi

  rm -f "$ttg_left" "$tt_left"
}

validate_no_unrealized_casts() {
  local file="$1"
  local left

  left="$(make_temp_file)"

  grep -nE 'builtin\.unrealized_conversion_cast|"builtin\.unrealized_conversion_cast"' \
    "$file" > "$left" || true

  if [[ -s "$left" ]]; then
    echo "fnacc-flang: error: unrealized conversion casts remain before LLVM translation:" >&2
    head -20 "$left" >&2
    rm -f "$left"
    exit 1
  fi

  rm -f "$left"
}

lower_residual_ttg_warp_id() {
  local file="$1"
  local tmp
  tmp="$(make_temp_file)"

  python3 - "$file" "$tmp" <<'PY'
import re
import sys

inp = sys.argv[1]
out = sys.argv[2]

pat = re.compile(
    r'^(\s*)(%[A-Za-z0-9_.$#-]+)\s*=\s*ttg\.warp_id'
    r'(?:\s*\{[^}]*\})?'
    r'(?:\s*:\s*i32)?\s*$'
)

changed = 0

with open(inp, "r", encoding="utf-8") as f, open(out, "w", encoding="utf-8") as g:
    for line in f:
        text = line.rstrip("\n")
        m = pat.match(text)
        if not m:
            g.write(line)
            continue

        indent, name = m.groups()
        g.write(
            f'{indent}{name} = llvm.inline_asm has_side_effects '
            f'asm_dialect = att "mov.u32 $0, %warpid;", "=r" '
            f': () -> i32\n'
        )
        changed += 1

if changed:
    print(
        f"fnacc-flang: lowered {changed} residual ttg.warp_id op(s) "
        f"using NVPTX inline asm",
        file=sys.stderr,
    )
PY

  mv "$tmp" "$file"
}

split_pass_pipeline() {
  local text="$1"
  python3 - "$text" <<'PY'
import shlex
import sys

for item in shlex.split(sys.argv[1]):
    print(item)
PY
}

split_ttir_per_kernel() {
  local ttir_file="$1"
  local json_file="$2"
  local out_dir="$3"
  local manifest="$4"

  mkdir -p "$out_dir"

  python3 - "$ttir_file" "$json_file" "$out_dir" "$manifest" <<'PY'
import json
import re
import sys
from pathlib import Path

ttir_path = Path(sys.argv[1])
json_path = Path(sys.argv[2])
out_dir = Path(sys.argv[3])
manifest_path = Path(sys.argv[4])

ttir = ttir_path.read_text(encoding="utf-8")

with json_path.open("r", encoding="utf-8") as f:
    data = json.load(f)

kernels = data.get("kernels", [])

def find_matching_brace(text, open_pos):
    depth = 0
    in_str = False
    escaped = False

    for i in range(open_pos, len(text)):
        c = text[i]

        if escaped:
            escaped = False
            continue

        if c == "\\" and in_str:
            escaped = True
            continue

        if c == '"':
            in_str = not in_str
            continue

        if in_str:
            continue

        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                return i + 1

    raise RuntimeError("unmatched brace")

def extract_tt_func(text, name):
    marker = f"tt.func @{name}"
    pos = text.find(marker)
    if pos < 0:
        raise RuntimeError(f"could not find TTIR function @{name}")

    line_start = text.rfind("\n", 0, pos) + 1

    sig_end = text.find("\n", pos)
    if sig_end < 0:
        raise RuntimeError(f"malformed one-line signature for @{name}")

    sig_line = text[pos:sig_end]

    # Current FNACC emits:
    #   tt.func @foo(...) attributes {noinline = false} {
    # The body opener is the last "{" on the signature line.
    rel_body_open = sig_line.rfind("{")
    if rel_body_open < 0:
        raise RuntimeError(f"could not find body opener for @{name}")

    body_open = pos + rel_body_open
    func_end = find_matching_brace(text, body_open)

    return text[line_start:func_end].rstrip() + "\n"

rows = []
seen_names = set()
seen_ids = set()

for idx, k in enumerate(kernels):
    name = str(k["name"])
    kernel_id = int(k["id"])
    num_warps = int(k.get("num_warps", 1))
    threads_per_warp = int(k.get("threads_per_warp", 32))
    num_ctas = int(k.get("num_ctas", 1))
    num_stages = int(k.get("num_stages", 3))

    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
        raise RuntimeError(f"unsafe or invalid kernel name: {name!r}")
    if name in seen_names or kernel_id in seen_ids:
        raise RuntimeError(f"duplicate kernel name or id: {name!r}, {kernel_id}")
    if kernel_id < 0 or num_warps <= 0 or threads_per_warp != 32:
        raise RuntimeError(f"invalid launch metadata for kernel {name}")
    if num_ctas <= 0 or num_stages <= 0:
        raise RuntimeError(f"invalid Triton metadata for kernel {name}")
    seen_names.add(name)
    seen_ids.add(kernel_id)

    func_text = extract_tt_func(ttir, name)

    module_text = (
        'module attributes {'
        f'"ttg.num-warps" = {num_warps} : i32, '
        f'"ttg.num-ctas" = {num_ctas} : i32, '
        f'"ttg.num-stages" = {num_stages} : i32, '
        f'"ttg.threads-per-warp" = {threads_per_warp} : i32'
        '} {\n'
        f'{func_text}'
        '}\n'
    )

    out_ttir = out_dir / f"{name}.ttir"
    out_ttir.write_text(module_text, encoding="utf-8")

    rows.append({
        "index": idx,
        "id": kernel_id,
        "name": name,
        "num_warps": num_warps,
        "threads_per_warp": threads_per_warp,
        "ttir": str(out_ttir),
        "ttgir": str(out_dir / f"{name}.ttgir.mlir"),
        "llvm_mlir": str(out_dir / f"{name}.llvm.mlir"),
        "ll": str(out_dir / f"{name}.ll"),
        "ptx": str(out_dir / f"{name}.ptx"),
    })

manifest_path.write_text(json.dumps(rows, indent=2), encoding="utf-8")
PY
}

manifest_count() {
  python3 - "$1" <<'PY'
import json, sys
with open(sys.argv[1], "r", encoding="utf-8") as f:
    print(len(json.load(f)))
PY
}

manifest_get() {
  local manifest="$1"
  local index="$2"
  local key="$3"

  python3 - "$manifest" "$index" "$key" <<'PY'
import json, sys
with open(sys.argv[1], "r", encoding="utf-8") as f:
    rows = json.load(f)
print(rows[int(sys.argv[2])][sys.argv[3]])
PY
}

read_effective_num_warps_from_json() {
  local json_file="$1"
  local fallback="$2"

  python3 - "$json_file" "$fallback" <<'PY'
import json
import sys

path = sys.argv[1]
fallback = int(sys.argv[2])

with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)

kernels = data.get("kernels", [])
if not kernels:
    print(fallback)
    raise SystemExit(0)

warps = []
for k in kernels:
    try:
        warps.append(int(k.get("num_warps", fallback)))
    except Exception:
        warps.append(fallback)

print(max(warps) if warps else fallback)
PY
}

is_fortran_source() {
  local lower="${1,,}"
  case "$lower" in
    *.f|*.for|*.ftn|*.f77|*.f90|*.f95|*.f03|*.f08|*.f18|*.f23)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

is_fortran_language() {
  case "${1,,}" in
    f77|f90|f95|f03|f08|f18|f23|fortran|fortran-free-form|fortran-fixed-form)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

source_has_fnacc() {
  local source="$1"
  [[ "$source" != "-" ]] || return 1
  grep -Eiq '^[[:space:]]*([!c*][[:space:]]*)?\$fnacc([[:space:]]|$)' "$source"
}

sanitize_stem() {
  local stem
  stem="$(basename "$1")"
  stem="${stem%.*}"
  stem="${stem//[^A-Za-z0-9._-]/_}"
  [[ -n "$stem" ]] || stem="source"
  printf '%s\n' "$stem"
}

resolve_flang() {
  LLVM_BUILD="${LLVM_BUILD:-}"
  if [[ -z "${FLANG:-}" && -n "$LLVM_BUILD" ]]; then
    if [[ -x "$LLVM_BUILD/bin/flang-new" ]]; then
      FLANG="$LLVM_BUILD/bin/flang-new"
    elif [[ -x "$LLVM_BUILD/bin/flang" ]]; then
      FLANG="$LLVM_BUILD/bin/flang"
    fi
  fi
  if [[ -z "${FLANG:-}" ]]; then
    FLANG="$(command -v flang-new || command -v flang || true)"
  fi
  [[ -n "${FLANG:-}" ]] || die "FLANG is not set and flang-new/flang was not found in PATH"
  require_exe "$FLANG"
}

resolve_flang_intrinsic_modules() {
  local -a compiler_flags=("$@")
  local -a module_dirs=()
  local resource_dir=""
  local target=""
  local intrinsic_dir=""
  local flag module_file
  local i

  # An explicit compiler option has precedence over wrapper discovery.
  for ((i = 0; i < ${#compiler_flags[@]}; ++i)); do
    flag="${compiler_flags[i]}"
    case "$flag" in
      -fintrinsic-modules-path|-fintrinsic-modules-path=*)
        return
        ;;
      -resource-dir)
        if ((i + 1 < ${#compiler_flags[@]})); then
          resource_dir="${compiler_flags[i + 1]}"
        fi
        ;;
      -resource-dir=*)
        resource_dir="${flag#*=}"
        ;;
      --target|-target)
        if ((i + 1 < ${#compiler_flags[@]})); then
          target="${compiler_flags[i + 1]}"
        fi
        ;;
      --target=*|-target=*)
        target="${flag#*=}"
        ;;
    esac
  done

  if [[ -n "${FLANG_INTRINSIC_MODULES_PATH:-}" ]]; then
    intrinsic_dir="$FLANG_INTRINSIC_MODULES_PATH"
  elif [[ "$DRY_RUN" == "1" ]]; then
    FLANG_FRONTEND_FLAGS+=(
      "-fintrinsic-modules-path=<auto-flang-intrinsic-modules>"
    )
    return
  else
    if [[ -z "$resource_dir" ]]; then
      resource_dir="$("$FLANG" --print-resource-dir 2>/dev/null || true)"
      resource_dir="${resource_dir%%$'\n'*}"
    fi
    [[ -n "$resource_dir" && -d "$resource_dir" ]] ||
      die "could not determine Flang's resource directory; set FLANG_INTRINSIC_MODULES_PATH"

    if [[ -z "$target" ]]; then
      target="$("$FLANG" --print-target-triple 2>/dev/null || true)"
      target="${target%%$'\n'*}"
    fi

    if [[ -n "$target" &&
      -f "$resource_dir/finclude/flang/$target/iso_fortran_env.mod" ]]; then
      intrinsic_dir="$resource_dir/finclude/flang/$target"
    else
      while IFS= read -r module_file; do
        module_dirs+=("${module_file%/*}")
      done < <(
        find "$resource_dir/finclude/flang" -type f \
          -name iso_fortran_env.mod -print 2>/dev/null
      )

      if ((${#module_dirs[@]} == 1)); then
        intrinsic_dir="${module_dirs[0]}"
      elif ((${#module_dirs[@]} > 1)) && [[ -n "$target" ]]; then
        for flag in "${module_dirs[@]}"; do
          if [[ "$flag" == */"$target" ]]; then
            [[ -z "$intrinsic_dir" ]] ||
              die "multiple Flang intrinsic module directories match target '$target'; set FLANG_INTRINSIC_MODULES_PATH"
            intrinsic_dir="$flag"
          fi
        done
      fi
    fi
  fi

  [[ -n "$intrinsic_dir" &&
    -f "$intrinsic_dir/iso_fortran_env.mod" &&
    -f "$intrinsic_dir/iso_c_binding.mod" ]] ||
    die "could not find Flang's iso_fortran_env.mod and iso_c_binding.mod; set FLANG_INTRINSIC_MODULES_PATH"

  FLANG_FRONTEND_FLAGS+=("-fintrinsic-modules-path=$intrinsic_dir")
  if [[ "$VERBOSE" == "1" ]]; then
    log "Flang intrinsic modules: $intrinsic_dir"
  fi
}

resolve_nm() {
  if [[ -n "${NM:-}" ]]; then
    return
  fi
  if [[ -n "${LLVM_BUILD:-}" && -x "$LLVM_BUILD/bin/llvm-nm" ]]; then
    NM="$LLVM_BUILD/bin/llvm-nm"
  else
    NM="$(command -v llvm-nm || command -v nm || true)"
  fi
}

count_embedded_bundles() {
  local input="$1"
  local symbols marker_count register_count
  [[ -n "${NM:-}" && -f "$input" ]] || {
    printf '0\n'
    return
  }

  symbols="$($NM -A "$input" 2>/dev/null || true)"
  marker_count="$(grep -c '__fnacc_single_embedded_bundle' <<<"$symbols" || true)"
  if (( marker_count > 0 )); then
    printf '%s\n' "$marker_count"
    return
  fi
  register_count="$(grep -c '__fnacc_register_embedded_kernel_bundle' <<<"$symbols" || true)"
  printf '%s\n' "$register_count"
}

input_needs_fnacc_runtime() {
  local input="$1"
  local symbols
  [[ -n "${NM:-}" && -f "$input" ]] || return 1
  symbols="$("$NM" -A "$input" 2>/dev/null || true)"
  grep -q '__fnacc_' <<<"$symbols" || return 1
}

add_compile_only() {
  COMPILE_FLAGS+=("$@")
}

add_link_only() {
  LINK_SEQUENCE+=("$@")
}

add_compile_and_link() {
  COMPILE_FLAGS+=("$@")
  LINK_SEQUENCE+=("$@")
}

add_host_codegen_if_compatible() {
  local flag="$1"
  case "$flag" in
    -O*|-g*|-m*|-pthread|-fopenmp|-fPIC|-fpic|-fPIE|-fpie|-fno-pic|-fno-PIC|-fno-pie|-fno-PIE|\
    -ffast-math|-fno-fast-math|-fno-math-errno|-funsafe-math-optimizations|\
    -fno-omit-frame-pointer|-fomit-frame-pointer|-fstack-protector*|-fcf-protection*|\
    -fsanitize=*|-fno-sanitize=*)
      HOST_CODEGEN_FLAGS+=("$flag")
      ;;
  esac
}

record_input() {
  local input="$1"
  local index
  if is_fortran_source "$input" || is_fortran_language "$CURRENT_LANGUAGE"; then
    index="${#SOURCES[@]}"
    SOURCES+=("$input")
    LINK_SEQUENCE+=("__FNACC_SOURCE_${index}__")
  else
    OTHER_INPUTS+=("$input")
    LINK_SEQUENCE+=("$input")
  fi
}

SOURCES=()
SOURCE_IS_FNACC=()
SOURCE_OBJECTS=()
OTHER_INPUTS=()
LINK_SEQUENCE=()
COMPILE_FLAGS=()
HOST_CODEGEN_FLAGS=()
HOST_RELOCATE_FLAGS=()
FLANG_FRONTEND_FLAGS=()
FLANG_ARGS=()

OUTPUT=""
COMPILE_ONLY=0
PASSTHROUGH_ONLY=0
RELOCATABLE_LINK=0
CURRENT_LANGUAGE="none"
AFTER_DASH_DASH=0
HAS_LTO=0

FORCE_FNACC=0
DISABLE_FNACC=0
FORCE_RUNTIME=0
DISABLE_RUNTIME=0

SM="${FNACC_SM:-80}"
NUM_WARPS="${FNACC_NUM_WARPS:-1}"
THREADS_PER_WARP="${FNACC_THREADS_PER_WARP:-32}"
NUM_STAGES="${FNACC_NUM_STAGES:-3}"
F64_MATMUL_STRATEGY="${FNACC_F64_MATMUL_STRATEGY:-reduce}"
CUDA_LIB_DIR="${CUDA_LIB_DIR:-}"
WORKDIR_PARENT="${FNACC_WORKDIR:-}"

KEEP=0
VERBOSE=0
DRY_RUN=0
STOP_AFTER=""
USER_WORKDIR_SET=0

while [[ $# -gt 0 ]]; do
  if [[ "$AFTER_DASH_DASH" == "1" ]]; then
    FLANG_ARGS+=("$1")
    record_input "$1"
    shift
    continue
  fi

  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --fnacc-force)
      FORCE_FNACC=1
      shift
      ;;
    --fnacc-disable)
      DISABLE_FNACC=1
      shift
      ;;
    --fnacc-runtime)
      FORCE_RUNTIME=1
      shift
      ;;
    --fnacc-no-runtime)
      DISABLE_RUNTIME=1
      shift
      ;;
    --fnacc-sm|--sm)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      SM="$2"
      shift 2
      ;;
    --fnacc-num-warps|--num-warps)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      NUM_WARPS="$2"
      shift 2
      ;;
    --fnacc-threads-per-warp|--threads-per-warp)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      THREADS_PER_WARP="$2"
      shift 2
      ;;
    --fnacc-num-stages|--num-stages)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      NUM_STAGES="$2"
      shift 2
      ;;
    --fnacc-f64-matmul-strategy|--f64-matmul-strategy)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      F64_MATMUL_STRATEGY="$2"
      shift 2
      ;;
    --fnacc-cuda-lib-dir|--cuda-lib-dir)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      CUDA_LIB_DIR="$2"
      shift 2
      ;;
    --fnacc-workdir|--workdir)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      WORKDIR_PARENT="$2"
      USER_WORKDIR_SET=1
      shift 2
      ;;
    --fnacc-keep|--keep|-save-temps)
      KEEP=1
      [[ "$1" != "-save-temps" ]] || FLANG_ARGS+=("$1")
      shift
      ;;
    --fnacc-verbose|--verbose)
      VERBOSE=1
      shift
      ;;
    --fnacc-dry-run|--dry-run)
      DRY_RUN=1
      shift
      ;;
    --fnacc-stop-after|--stop-after)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      STOP_AFTER="$2"
      KEEP=1
      shift 2
      ;;
    --fflag)
      [[ $# -ge 2 ]] || die "--fflag requires an argument"
      add_compile_only "$2"
      shift 2
      ;;
    --ldflag)
      [[ $# -ge 2 ]] || die "--ldflag requires an argument"
      add_link_only "$2"
      shift 2
      ;;
    --lib)
      [[ $# -ge 2 ]] || die "--lib requires an argument"
      add_link_only "-l$2"
      shift 2
      ;;
    --kernel-src|--main-src|--extra-src)
      die "$1 belongs to the restricted wrapper; pass the source filename directly"
      ;;
    --no-embed|--runner-uses-files|--fnacc-no-embed)
      die "$1 is incompatible with self-contained, separately linkable objects"
      ;;
    -c)
      COMPILE_ONLY=1
      FLANG_ARGS+=("$1")
      shift
      ;;
    -E|-S|-fsyntax-only)
      PASSTHROUGH_ONLY=1
      FLANG_ARGS+=("$1")
      shift
      ;;
    -r)
      RELOCATABLE_LINK=1
      FLANG_ARGS+=("$1")
      add_link_only "$1"
      shift
      ;;
    -o)
      [[ $# -ge 2 ]] || die "-o requires an argument"
      OUTPUT="$2"
      FLANG_ARGS+=("$1" "$2")
      shift 2
      ;;
    -o?*)
      OUTPUT="${1#-o}"
      FLANG_ARGS+=("$1")
      shift
      ;;
    -x)
      [[ $# -ge 2 ]] || die "-x requires an argument"
      CURRENT_LANGUAGE="$2"
      FLANG_ARGS+=("$1" "$2")
      add_compile_only "$1" "$2"
      shift 2
      ;;
    -I|-J|-D|-U|-isystem|-iquote|-idirafter|-include|-module-dir|-fintrinsic-modules-path|-Xflang|-Xpreprocessor|-Xassembler|-MF|-MT|-MQ|-dependency-file)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      FLANG_ARGS+=("$1" "$2")
      add_compile_only "$1" "$2"
      if [[ "$1" == "-Xassembler" ]]; then
        HOST_CODEGEN_FLAGS+=("$1" "$2")
      fi
      shift 2
      ;;
    -M|-MM|-MD|-MMD|-MP|-MG)
      FLANG_ARGS+=("$1")
      add_compile_only "$1"
      shift
      ;;
    -I?*|-J?*|-D?*|-U?*|-isystem?*|-iquote?*|-idirafter?*|-include?*|-module-dir=*|-fintrinsic-modules-path=*)
      FLANG_ARGS+=("$1")
      add_compile_only "$1"
      shift
      ;;
    -L|-l|-Xlinker|-Xoffload-linker|-u|-T|-framework|-weak_framework|-undefined|-Wl)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      FLANG_ARGS+=("$1" "$2")
      add_link_only "$1" "$2"
      shift 2
      ;;
    -L?*|-l?*|-Wl,*|-shared|-static|-static-pie|-pie|-no-pie|-rdynamic|-s|-nostdlib|-nodefaultlibs|-nostartfiles)
      FLANG_ARGS+=("$1")
      add_link_only "$1"
      shift
      ;;
    --target|-target|--sysroot|-isysroot|-resource-dir|-gcc-toolchain|--gcc-toolchain|-B|-mcpu|-march|-mtune)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      FLANG_ARGS+=("$1" "$2")
      add_compile_and_link "$1" "$2"
      HOST_CODEGEN_FLAGS+=("$1" "$2")
      HOST_RELOCATE_FLAGS+=("$1" "$2")
      shift 2
      ;;
    --target=*|--sysroot=*|-fuse-ld=*)
      FLANG_ARGS+=("$1")
      add_compile_and_link "$1"
      HOST_CODEGEN_FLAGS+=("$1")
      HOST_RELOCATE_FLAGS+=("$1")
      shift
      ;;
    -flto|-flto=*)
      HAS_LTO=1
      FLANG_ARGS+=("$1")
      add_compile_and_link "$1"
      shift
      ;;
    -Wa,*|-Wp,*)
      FLANG_ARGS+=("$1")
      add_compile_only "$1"
      [[ "$1" != -Wa,* ]] || HOST_CODEGEN_FLAGS+=("$1")
      shift
      ;;
    --)
      AFTER_DASH_DASH=1
      FLANG_ARGS+=("$1")
      shift
      ;;
    @*)
      FLANG_ARGS+=("$1")
      add_compile_and_link "$1"
      shift
      ;;
    -*)
      FLANG_ARGS+=("$1")
      add_compile_and_link "$1"
      add_host_codegen_if_compatible "$1"
      case "$1" in
        -m32|-m64) HOST_RELOCATE_FLAGS+=("$1") ;;
      esac
      shift
      ;;
    *)
      FLANG_ARGS+=("$1")
      record_input "$1"
      shift
      ;;
  esac
done

[[ "$FORCE_FNACC" == "0" || "$DISABLE_FNACC" == "0" ]] ||
  die "--fnacc-force and --fnacc-disable are mutually exclusive"
[[ "$FORCE_RUNTIME" == "0" || "$DISABLE_RUNTIME" == "0" ]] ||
  die "--fnacc-runtime and --fnacc-no-runtime are mutually exclusive"

resolve_flang

if [[ "$PASSTHROUGH_ONLY" == "1" ]]; then
  run "$FLANG" "${FLANG_ARGS[@]}"
  exit 0
fi

if [[ ${#SOURCES[@]} -eq 0 && ${#OTHER_INPUTS[@]} -eq 0 ]]; then
  if [[ ${#FLANG_ARGS[@]} -gt 0 ]]; then
    run "$FLANG" "${FLANG_ARGS[@]}"
    exit 0
  fi
  die "no input files"
fi

for source in "${SOURCES[@]}"; do
  [[ "$source" == "-" ]] || require_file "$source"
done

for source in "${SOURCES[@]}"; do
  if [[ "$DISABLE_FNACC" == "1" ]]; then
    SOURCE_IS_FNACC+=(0)
  elif [[ "$FORCE_FNACC" == "1" ]]; then
    [[ "$source" != "-" ]] || die "FNACC compilation from standard input is not supported"
    SOURCE_IS_FNACC+=(1)
  elif source_has_fnacc "$source"; then
    SOURCE_IS_FNACC+=(1)
  else
    SOURCE_IS_FNACC+=(0)
  fi
done

FNACC_SOURCE_COUNT=0
for value in "${SOURCE_IS_FNACC[@]}"; do
  (( FNACC_SOURCE_COUNT += value )) || true
done

if [[ "$COMPILE_ONLY" != "1" && "$FNACC_SOURCE_COUNT" -gt 1 ]]; then
  die "the current runtime supports one FNACC source bundle per final link; compile/link one FNACC source and any number of ordinary sources"
fi

if [[ -n "$STOP_AFTER" && "$FNACC_SOURCE_COUNT" -ne 1 ]]; then
  die "--fnacc-stop-after requires exactly one FNACC source"
fi

if [[ "$COMPILE_ONLY" == "1" && -n "$OUTPUT" && ${#SOURCES[@]} -ne 1 ]]; then
  die "cannot use -o with -c and multiple source files"
fi

if [[ "$COMPILE_ONLY" == "1" && ${#OTHER_INPUTS[@]} -gt 0 && "$FNACC_SOURCE_COUNT" -gt 0 ]]; then
  die "object and library inputs are not accepted with -c"
fi

if [[ "$FNACC_SOURCE_COUNT" == "0" && "$FORCE_RUNTIME" == "0" ]]; then
  if [[ "$COMPILE_ONLY" == "1" ]]; then
    run "$FLANG" "${FLANG_ARGS[@]}"
    exit 0
  fi

  resolve_nm
  EXISTING_FNACC=0
  for input in "${OTHER_INPUTS[@]}"; do
    if input_needs_fnacc_runtime "$input"; then
      EXISTING_FNACC=1
      break
    fi
  done
  if [[ "$EXISTING_FNACC" == "0" ]]; then
    run "$FLANG" "${FLANG_ARGS[@]}"
    exit 0
  fi
fi

case "$STOP_AFTER" in
  ""|modgen|fir|fnacc-pipeline|ttgir|llvm-mlir|llvm-ir|ptx|embed|host-ll|host-obj|object|objects|link)
    ;;
  *)
    die "invalid --fnacc-stop-after stage: $STOP_AFTER"
    ;;
esac

case "$F64_MATMUL_STRATEGY" in
  reduce|fma|dot) ;;
  *) die "invalid FNACC F64 matmul strategy '$F64_MATMUL_STRATEGY'; expected reduce, fma, or dot" ;;
esac

if (( FNACC_SOURCE_COUNT > 0 )); then
  SM="${SM#sm_}"
  SM="${SM#cc}"
  [[ "$SM" =~ ^[0-9]+$ ]] ||
    die "invalid CUDA SM value '$SM'; expected e.g. 80, sm_80, or cc80"
  [[ "$NUM_WARPS" =~ ^[0-9]+$ ]] || die "invalid num-warps value '$NUM_WARPS'"
  [[ "$THREADS_PER_WARP" =~ ^[0-9]+$ ]] || die "invalid threads-per-warp value '$THREADS_PER_WARP'"
  [[ "$NUM_STAGES" =~ ^[0-9]+$ ]] || die "invalid num-stages value '$NUM_STAGES'"

  if (( ${#SM} > 3 || ${#NUM_WARPS} > 3 || ${#THREADS_PER_WARP} > 3 || ${#NUM_STAGES} > 2 )); then
    die "numeric FNACC launch option is outside the supported range"
  fi

  SM=$((10#$SM))
  NUM_WARPS=$((10#$NUM_WARPS))
  THREADS_PER_WARP=$((10#$THREADS_PER_WARP))
  NUM_STAGES=$((10#$NUM_STAGES))

  (( NUM_WARPS > 0 )) || die "num-warps must be positive"
  (( (NUM_WARPS & (NUM_WARPS - 1)) == 0 )) || die "num-warps must be a power of two"
  (( NUM_WARPS <= 32 )) || die "num-warps must not exceed 32"
  (( THREADS_PER_WARP == 32 )) || die "CUDA lowering currently requires --fnacc-threads-per-warp 32"
  (( NUM_STAGES > 0 && NUM_STAGES <= 16 )) || die "num-stages must be between 1 and 16"
  [[ "$HAS_LTO" == "0" ]] || die "LTO is not supported when compiling an FNACC source"

  [[ -n "${LLVM_BUILD:-}" ]] || die "LLVM_BUILD is required for FNACC compilation"
  FIROPT="${FIROPT:-$LLVM_BUILD/bin/fir-opt}"
  TCO="${TCO:-$LLVM_BUILD/bin/tco}"
  CLANG="${CLANG:-$LLVM_BUILD/bin/clang}"
  TRITON_OPT="${TRITON_OPT:-}"
  MLIR_TRANSLATE="${MLIR_TRANSLATE:-}"
  LLC="${LLC:-}"

  [[ -n "$TRITON_OPT" ]] || die "TRITON_OPT is not set"
  [[ -n "$MLIR_TRANSLATE" ]] || die "MLIR_TRANSLATE is not set"
  [[ -n "$LLC" ]] || die "LLC is not set"

  require_exe "$FIROPT"
  require_exe "$TCO"
  require_exe "$CLANG"
  require_exe "$TRITON_OPT"
  require_exe "$MLIR_TRANSLATE"
  require_exe "$LLC"
fi

if [[ -n "$CUDA_LIB_DIR" && ! -d "$CUDA_LIB_DIR" ]]; then
  die "CUDA library directory does not exist: $CUDA_LIB_DIR"
fi

if [[ -n "$WORKDIR_PARENT" && "$WORKDIR_PARENT" =~ [[:space:]] ]]; then
  die "FNACC work directories must not contain whitespace because MLIR pass options cannot represent it safely"
fi

if [[ -n "$OUTPUT" ]]; then
  WORK_BASE="$(sanitize_stem "$OUTPUT")"
elif [[ ${#SOURCES[@]} -gt 0 ]]; then
  WORK_BASE="$(sanitize_stem "${SOURCES[0]}")"
else
  WORK_BASE="link"
fi

if [[ "$DRY_RUN" == "1" ]]; then
  if [[ -n "$WORKDIR_PARENT" ]]; then
    WORKDIR="$WORKDIR_PARENT/fnacc-${WORK_BASE}.dry-run"
  else
    WORKDIR="${TMPDIR:-$PWD}/fnacc-${WORK_BASE}.dry-run"
  fi
else
  if [[ -z "$WORKDIR_PARENT" ]]; then
    WORKDIR_PARENT="${TMPDIR:-/tmp}"
    if [[ ! -d "$WORKDIR_PARENT" || ! -w "$WORKDIR_PARENT" ]]; then
      WORKDIR_PARENT="$PWD"
    fi
  fi
  [[ ! "$WORKDIR_PARENT" =~ [[:space:]] ]] ||
    die "no writable whitespace-free temporary directory is available"
  mkdir -p "$WORKDIR_PARENT"
  WORKDIR="$(mktemp -d "$WORKDIR_PARENT/fnacc-${WORK_BASE}.XXXXXX")"
fi

OBJ_DIR="$WORKDIR/obj"
if [[ "$DRY_RUN" != "1" ]]; then
  mkdir -p "$OBJ_DIR"
fi

cleanup() {
  if [[ "$KEEP" != "1" && "$DRY_RUN" != "1" ]]; then
    rm -rf "$WORKDIR"
  fi
}
trap cleanup EXIT

if ((FNACC_SOURCE_COUNT > 0)); then
  resolve_flang_intrinsic_modules "${COMPILE_FLAGS[@]}"
fi

if (( FNACC_SOURCE_COUNT > 0 )) && [[ "$DRY_RUN" != "1" ]]; then
  write_toolchain_manifest "$WORKDIR/toolchain.txt"
fi

compile_plain_source() {
  local source="$1"
  local output="$2"
  log "compile Fortran: $source -> $output"
  run "$FLANG" "${COMPILE_FLAGS[@]}" -c "$source" -o "$output"
  if [[ "$DRY_RUN" != "1" ]]; then
    test -s "$output" || die "object was not generated: $output"
  fi
}

compile_fnacc_source() {
  local source="$1"
  local output="$2"
  local stem source_hash base_path
  local fir host_fir host_ll host_obj
  local ttir json split_dir manifest embed_c embed_obj
  local effective_num_warps count
  local ki kernel_name kernel_warps kernel_ttir kernel_ttgir kernel_llvm_mlir kernel_ll kernel_ptx

  stem="$(sanitize_stem "$source")"
  source_hash="$(hash_path "$source")"
  base_path="$WORKDIR/${stem}_${source_hash}"
  fir="$base_path.fir"
  host_fir="$base_path.host.fir"
  host_ll="$base_path.host.ll"
  host_obj="$base_path.host.o"
  ttir="$base_path.kernels.ttir"
  json="$base_path.kernels.json"
  split_dir="$base_path.kernels.split"
  manifest="$base_path.kernels.manifest.json"
  embed_c="$base_path.embedded.c"
  embed_obj="$base_path.embedded.o"

  log "FNACC compile: $source -> $output"
  log "  target: sm_$SM, warps=$NUM_WARPS, threads/warp=$THREADS_PER_WARP, stages=$NUM_STAGES"

  log "  [1/9] Generate Fortran module files"
  run "$FLANG" -fsyntax-only "$source" "${COMPILE_FLAGS[@]}"
  maybe_stop modgen

  log "  [2/9] Emit FIR"
  run "$FLANG" -fc1 -emit-fir \
    "${FLANG_FRONTEND_FLAGS[@]}" \
    "$source" "${COMPILE_FLAGS[@]}" -o "$fir"
  if [[ "$DRY_RUN" != "1" ]]; then
    test -s "$fir" || die "FIR was not generated: $fir"
  fi
  maybe_stop fir

  log "  [3/9] Run FNACC pipeline"
  run "$FIROPT" \
    "--fnacc-pipeline=ttir-output=$ttir json-output=$json emit-fortran-aliases=true num-warps=$NUM_WARPS threads-per-warp=$THREADS_PER_WARP num-stages=$NUM_STAGES f64-matmul-strategy=$F64_MATMUL_STRATEGY" \
    "$fir" -o "$host_fir"
  if [[ "$DRY_RUN" != "1" ]]; then
    test -s "$ttir" || die "TTIR was not generated: $ttir"
    test -s "$json" || die "JSON was not generated: $json"
    test -s "$host_fir" || die "host FIR was not generated: $host_fir"
    validate_json "$json"
    validate_kernel_json_nonempty "$json"
  fi
  maybe_stop fnacc-pipeline

  effective_num_warps="$NUM_WARPS"
  if [[ "$DRY_RUN" != "1" ]]; then
    effective_num_warps="$(read_effective_num_warps_from_json "$json" "$NUM_WARPS")"
  fi
  log "  effective warps: $effective_num_warps"

  if [[ "$DRY_RUN" == "1" ]]; then
    quote_cmd python3 "<split-ttir-helper>" "$ttir" "$json" "$split_dir" "$manifest"
    quote_cmd "$TRITON_OPT" "<kernel.ttir>" \
      "--convert-triton-to-tritongpu=target=cuda:$SM num-warps=<kernel-warps>" \
      -o "<kernel.ttgir.mlir>"
    maybe_stop ttgir
    quote_cmd "$TRITON_OPT" "<kernel.ttgir.mlir>" "<configured-lowering-passes>" \
      -o "<kernel.llvm.mlir>"
    maybe_stop llvm-mlir
    quote_cmd "$MLIR_TRANSLATE" --mlir-to-llvmir "<kernel.llvm.mlir>" -o "<kernel.ll>"
    maybe_stop llvm-ir
    quote_cmd "$LLC" -march=nvptx64 "-mcpu=sm_$SM" "<kernel.ll>" -o "<kernel.ptx>"
    maybe_stop ptx
  else
    log "  [4/9] Split TTIR per kernel"
    split_ttir_per_kernel "$ttir" "$json" "$split_dir" "$manifest"
    test -s "$manifest" || die "kernel manifest was not generated: $manifest"
    count="$(manifest_count "$manifest")"

    log "  [5/9] Lower kernels to TTGIR"
    for ((ki = 0; ki < count; ++ki)); do
      kernel_name="$(manifest_get "$manifest" "$ki" name)"
      kernel_warps="$(manifest_get "$manifest" "$ki" num_warps)"
      kernel_ttir="$(manifest_get "$manifest" "$ki" ttir)"
      kernel_ttgir="$(manifest_get "$manifest" "$ki" ttgir)"
      if [[ -n "${FNACC_TTIR_TO_TTGIR_PASSES:-}" ]]; then
        mapfile -t TTIR_TO_TTGIR_PASSES < <(split_pass_pipeline "$FNACC_TTIR_TO_TTGIR_PASSES")
        run "$TRITON_OPT" "$kernel_ttir" "${TTIR_TO_TTGIR_PASSES[@]}" -o "$kernel_ttgir"
      else
        run "$TRITON_OPT" "$kernel_ttir" \
          "--convert-triton-to-tritongpu=target=cuda:$SM num-warps=$kernel_warps" \
          --tritongpu-accelerate-matmul --canonicalize --cse -o "$kernel_ttgir"
      fi
      test -s "$kernel_ttgir" || die "TTGIR was not generated for $kernel_name"
    done
    maybe_stop ttgir

    log "  [6/9] Lower TTGIR to LLVM MLIR"
    for ((ki = 0; ki < count; ++ki)); do
      kernel_name="$(manifest_get "$manifest" "$ki" name)"
      kernel_ttgir="$(manifest_get "$manifest" "$ki" ttgir)"
      kernel_llvm_mlir="$(manifest_get "$manifest" "$ki" llvm_mlir)"
      if [[ -n "${FNACC_TTGIR_TO_LLVM_PASSES:-}" ]]; then
        mapfile -t TTGIR_TO_LLVM_PASSES < <(split_pass_pipeline "$FNACC_TTGIR_TO_LLVM_PASSES")
        run "$TRITON_OPT" "$kernel_ttgir" "${TTGIR_TO_LLVM_PASSES[@]}" -o "$kernel_llvm_mlir"
      else
        run "$TRITON_OPT" "$kernel_ttgir" \
          --tritongpu-coalesce \
          --tritongpu-remove-layout-conversions \
          --tritongpu-optimize-thread-locality \
          --triton-nvidia-gpu-plan-cta \
          --tritongpu-allocate-warp-groups \
          --triton-nvidia-mma-lowering \
          --allocate-shared-memory-nv \
          --convert-scf-to-cf \
          --canonicalize \
          --cse \
          --convert-triton-gpu-to-llvm \
          --canonicalize \
          --cse \
          --convert-nv-gpu-to-llvm \
          --convert-index-to-llvm \
          --convert-arith-to-llvm \
          --convert-math-to-llvm \
          --convert-cf-to-llvm \
          --reconcile-unrealized-casts \
          --canonicalize \
          --cse \
          -o "$kernel_llvm_mlir"
      fi
      test -s "$kernel_llvm_mlir" || die "kernel LLVM MLIR was not generated for $kernel_name"
      if [[ "${FNACC_PATCH_TTG_WARP_ID:-0}" == "1" ]]; then
        warn "applying version-sensitive ttg.warp_id workaround"
        lower_residual_ttg_warp_id "$kernel_llvm_mlir"
      fi
      validate_no_triton_gpu_ops "$kernel_llvm_mlir"
      validate_no_unrealized_casts "$kernel_llvm_mlir"
    done
    maybe_stop llvm-mlir

    log "  [7/9] Translate kernels to LLVM IR"
    for ((ki = 0; ki < count; ++ki)); do
      kernel_name="$(manifest_get "$manifest" "$ki" name)"
      kernel_llvm_mlir="$(manifest_get "$manifest" "$ki" llvm_mlir)"
      kernel_ll="$(manifest_get "$manifest" "$ki" ll)"
      run "$MLIR_TRANSLATE" --mlir-to-llvmir "$kernel_llvm_mlir" -o "$kernel_ll"
      test -s "$kernel_ll" || die "kernel LLVM IR was not generated for $kernel_name"
    done
    maybe_stop llvm-ir

    log "  [7/9] Compile kernels to PTX"
    for ((ki = 0; ki < count; ++ki)); do
      kernel_name="$(manifest_get "$manifest" "$ki" name)"
      kernel_ll="$(manifest_get "$manifest" "$ki" ll)"
      kernel_ptx="$(manifest_get "$manifest" "$ki" ptx)"
      run "$LLC" -march=nvptx64 "-mcpu=sm_$SM" "$kernel_ll" -o "$kernel_ptx"
      test -s "$kernel_ptx" || die "PTX was not generated for $kernel_name"
    done
    validate_ptx_kernel_abi "$manifest" "$json"
    maybe_stop ptx
  fi

  log "  [8/9] Embed kernel bundle"
  if [[ "$DRY_RUN" == "1" ]]; then
    quote_cmd python3 "<embed-bundle-helper>" "$manifest" "$json" "$embed_c"
    run "$CLANG" "${HOST_CODEGEN_FLAGS[@]}" -c "$embed_c" -o "$embed_obj"
  else
    generate_embedded_bundle_c "$manifest" "$json" "$embed_c"
    run "$CLANG" "${HOST_CODEGEN_FLAGS[@]}" -c "$embed_c" -o "$embed_obj"
    test -s "$embed_obj" || die "embedded object was not generated: $embed_obj"
  fi
  maybe_stop embed

  log "  [9/9] Generate host object"
  run "$TCO" "$host_fir" -o "$host_ll"
  if [[ "$DRY_RUN" != "1" ]]; then
    test -s "$host_ll" || die "host LLVM IR was not generated: $host_ll"
  fi
  maybe_stop host-ll

  run "$CLANG" "${HOST_CODEGEN_FLAGS[@]}" -c "$host_ll" -o "$host_obj"
  if [[ "$DRY_RUN" != "1" ]]; then
    test -s "$host_obj" || die "host object was not generated: $host_obj"
  fi
  maybe_stop host-obj

  # A relocatable link turns the host and bundle objects into one conventional
  # object.  It can be archived, copied, and linked later without sidecars.
  run "$CLANG" "${HOST_RELOCATE_FLAGS[@]}" -nostdlib -r \
    "$host_obj" "$embed_obj" -o "$output"
  if [[ "$DRY_RUN" != "1" ]]; then
    test -s "$output" || die "FNACC object was not generated: $output"
  fi
  maybe_stop object
}

declare -A COMPILE_OUTPUTS_SEEN=()
for index in "${!SOURCES[@]}"; do
  source="${SOURCES[$index]}"
  if [[ "$COMPILE_ONLY" == "1" ]]; then
    if [[ -n "$OUTPUT" ]]; then
      object="$OUTPUT"
    else
      object="$(sanitize_stem "$source").o"
    fi
    if [[ -n "${COMPILE_OUTPUTS_SEEN[$object]:-}" ]]; then
      die "multiple sources would write the same object: $object"
    fi
    COMPILE_OUTPUTS_SEEN["$object"]=1
  else
    object="$(object_for_src "$source")"
  fi
  SOURCE_OBJECTS[$index]="$object"

  if [[ "${SOURCE_IS_FNACC[$index]}" == "1" ]]; then
    compile_fnacc_source "$source" "$object"
  else
    compile_plain_source "$source" "$object"
  fi
done

maybe_stop objects

if [[ "$COMPILE_ONLY" == "1" ]]; then
  log "done"
  for object in "${SOURCE_OBJECTS[@]}"; do
    log "object: $object"
  done
  if [[ "$KEEP" == "1" ]]; then
    log "workdir kept: $WORKDIR"
  fi
  exit 0
fi

FINAL_LINK_ARGS=()
for item in "${LINK_SEQUENCE[@]}"; do
  if [[ "$item" =~ ^__FNACC_SOURCE_([0-9]+)__$ ]]; then
    index="${BASH_REMATCH[1]}"
    FINAL_LINK_ARGS+=("${SOURCE_OBJECTS[$index]}")
  else
    FINAL_LINK_ARGS+=("$item")
  fi
done

resolve_nm
NEEDS_FNACC_RUNTIME="$FORCE_RUNTIME"
BUNDLE_COUNT="$FNACC_SOURCE_COUNT"
if (( FNACC_SOURCE_COUNT > 0 )); then
  NEEDS_FNACC_RUNTIME=1
fi

for input in "${OTHER_INPUTS[@]}"; do
  if input_needs_fnacc_runtime "$input"; then
    NEEDS_FNACC_RUNTIME=1
  fi
  existing_bundles="$(count_embedded_bundles "$input")"
  (( BUNDLE_COUNT += existing_bundles )) || true
done

if (( BUNDLE_COUNT > 1 )); then
  die "link contains $BUNDLE_COUNT embedded FNACC bundles; the current runtime supports one. Combine FNACC kernels into one source/module before compiling"
fi

RUNTIME_LINK_FLAGS=()
if [[ "$NEEDS_FNACC_RUNTIME" == "1" && "$DISABLE_RUNTIME" != "1" && "$RELOCATABLE_LINK" != "1" ]]; then
  [[ -n "${LLVM_BUILD:-}" ]] || die "LLVM_BUILD is required to link the FNACC runtime"
  RUNTIME_LINK_FLAGS+=("-L$LLVM_BUILD/lib" -lFortranFNACCRuntime)
  if [[ -n "$CUDA_LIB_DIR" ]]; then
    RUNTIME_LINK_FLAGS+=("-L$CUDA_LIB_DIR" "-Wl,-rpath,$CUDA_LIB_DIR")
  fi
  RUNTIME_LINK_FLAGS+=(-lcuda -lstdc++ "-Wl,-rpath,$LLVM_BUILD/lib")
fi

[[ -n "$OUTPUT" ]] || OUTPUT="a.out"

log "link: ${#SOURCES[@]} source object(s), ${#OTHER_INPUTS[@]} other input(s) -> $OUTPUT"
if [[ "$NEEDS_FNACC_RUNTIME" == "1" ]]; then
  log "FNACC runtime: $([[ "$DISABLE_RUNTIME" == "1" || "$RELOCATABLE_LINK" == "1" ]] && echo deferred || echo enabled)"
fi

run "$FLANG" \
  "${FINAL_LINK_ARGS[@]}" \
  "${RUNTIME_LINK_FLAGS[@]}" \
  -o "$OUTPUT"

if [[ "$DRY_RUN" != "1" ]]; then
  test -f "$OUTPUT" || die "link output was not generated: $OUTPUT"
fi

maybe_stop link

log "done"
log "output: $OUTPUT"
if [[ "$KEEP" == "1" ]]; then
  log "workdir kept: $WORKDIR"
  if (( FNACC_SOURCE_COUNT > 0 )); then
    log "toolchain: $WORKDIR/toolchain.txt"
  fi
fi

